{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --mode demo --base=/shop-react/ --port 4317 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4317/shop-react/",
        "http://localhost:4317/shop-react/produkt/espresso-blend"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
